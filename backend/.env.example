# Copy this file to .env and fill in real values before running the app.

# Local PostgreSQL you already have installed.
DATABASE_URL="postgresql://manzil:replace-with-db-password@localhost:5432/manzil_dev?schema=public"

# Generate real random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=3000
TRUST_PROXY_HOPS=0
NODE_ENV=development

# Comma-separated list of allowed frontend origins (provider, marketplace, admin dev servers).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Required only for the explicitly invoked seed command; minimum 12 characters.
SEED_ADMIN_PASSWORD="replace-with-unique-admin-password"
SEED_ADMIN_EMAIL="admin@manzil.af"
# Optional local fixtures only. Do not enable in production.
SEED_DEMO_OWNER=false
SEED_OWNER_PASSWORD="replace-with-distinct-owner-password"
