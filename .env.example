# Use URL-safe random strings here; encode reserved characters in DB passwords.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082
# Exactly one trusted Nginx hop in the supplied Compose topology.
TRUST_PROXY_HOPS=1
